.cursor
.claude
.playwright-cli
# Local .github tooling stays untracked, but CI workflow definitions MUST be
# committed — a blanket `.github` ignore is why visual-regression.yml never
# reached this branch.
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/*.yml
!.github/workflows/*.yaml
.env
.env.*
!.env.example

# =============================================================================
# Design image binaries — keep on disk locally; do not commit to git
# =============================================================================
# Tracked on purpose:
#   prototype/project/favicon.svg
#   prototype/project/icons/icon-*.png

# Audit + iteration scratch captures (referenced by docs as local evidence only)
docs/design/**/*.jpeg
docs/design/**/*.jpg
docs/design/**/*.png
docs/design/**/*.webp
docs/design/**/*.gif

# Optional visual-regression baselines (see docs/design/screenshots/README.md)
docs/design/screenshots/*
!docs/design/screenshots/README.md
node_modules/
test-results/
playwright-report/
visual-regression-artifacts/
npm-debug.log*

# =============================================================================
# Approved visual baselines — MUST be committed
# =============================================================================
# A bare `snapshots/` rule used to ignore tests/regression/snapshots entirely.
# That made the approved baselines invisible to git, so CI checked out zero
# baselines and every run failed the missing-baseline preflight.
#
# Docker/Linux is the canonical rendering environment (see
# tests/docs/visual-regression-baselines.md), so the approved set is the
# *-chromium-linux.png files plus baseline-manifest.json. Locally rendered
# darwin/win32 PNGs are scratch output and stay untracked.
tests/regression/snapshots/**/*-darwin.png
tests/regression/snapshots/**/*-win32.png
# Only the canonical baseline-manifest.json is committed. Per-platform local
# manifests are scratch provenance for framework validation.
tests/regression/snapshots/baseline-manifest.*.json

# Local portrait-lock QA runner + screenshots (ad-hoc; do not commit)
portrait-qa-artifacts/
portrait-qa-run.mjs

# Windows reserved device names (cmd-style `2>nul` in bash creates a real file)
nul
NUL
con
CON
prn
PRN
aux
AUX
com[1-9]
COM[1-9]
lpt[1-9]
LPT[1-9]
