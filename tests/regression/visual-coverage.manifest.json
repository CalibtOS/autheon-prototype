{
  "$comment": [
    "AUTHEON visual coverage registry — the machine-readable source of truth for",
    "WHAT must be captured. The specs under tests/regression/*.visual.spec.ts own",
    "HOW each state is reached; this file owns the inventory, the metadata, and the",
    "expected-snapshot list that the coverage gate compares against.",
    "",
    "status semantics (see scripts/visual-coverage-audit.mjs):",
    "  active   - must be captured by the suite AND must have an approved baseline.",
    "             A missing capture or missing baseline is BLOCKING.",
    "  planned  - registered coverage that is declared but not yet implemented or",
    "             not yet baseline-approved. Reported as MISSING COVERAGE (visible,",
    "             non-blocking) so a run can never claim complete coverage while a",
    "             registered gap is open.",
    "  excluded - deliberately out of scope. Requires exclusionReason.",
    "  deprecated - retired scenario. Its baseline is reported as an orphan to remove.",
    "",
    "Entries inherit every field from `defaults` and override only what differs."
  ],
  "registryVersion": 1,
  "grep": "@visual-regression",
  "approvedPlatform": "linux",
  "viewports": {
    "desktop-1440": {
      "project": "chromium",
      "width": 1440,
      "height": 1100,
      "class": "laptop/desktop",
      "notes": "Canonical presentation viewport for the prototype shell at /. Existing approved baselines were rendered here."
    },
    "desktop-1920": {
      "project": "admin-desktop-1920",
      "width": 1920,
      "height": 1200,
      "class": "large desktop",
      "notes": "Admin console on a large monitor: wider tables, more visible columns."
    },
    "phone-320": {
      "project": "pwa-phone-320",
      "width": 320,
      "height": 568,
      "class": "narrow phone",
      "notes": "Smallest supported Driver PWA width at /pwa/. Catches label truncation and tabbar crowding."
    },
    "phone-390": {
      "project": "pwa-phone-390",
      "width": 390,
      "height": 844,
      "class": "standard phone",
      "notes": "Primary Driver PWA target at /pwa/."
    },
    "phone-430": {
      "project": "pwa-phone-430",
      "width": 430,
      "height": 932,
      "class": "large phone",
      "notes": "Large Driver PWA phone at /pwa/."
    },
    "tablet-834": {
      "project": "pwa-tablet-834",
      "width": 834,
      "height": 1112,
      "class": "wider tablet",
      "notes": "Driver PWA stretched to tablet width. Not a separate tablet product layout — the same phone layout at a wider viewport."
    },
    "document-a4": {
      "project": "chromium",
      "width": 794,
      "height": 1123,
      "class": "print document",
      "notes": "A4 at 96dpi. The transport-order PDF preview sets this viewport itself inside the chromium project; it is not a separate Playwright project."
    }
  },
  "locales": {
    "en": {
      "label": "English",
      "primary": true
    },
    "de": {
      "label": "Deutsch",
      "primary": false,
      "notes": "German is the longest-translation locale in this product and is the wrapping risk case for tabbars, table headers, and dialog action rows."
    }
  },
  "themes": {
    "light": {
      "production": true
    },
    "dark": {
      "production": true
    }
  },
  "screenshotModes": {
    "fullPage": "Whole scrollable document. Proves complete content layout.",
    "viewport": "Visible viewport only at the project height. The only mode that proves fixed/sticky chrome (driver tabbar, admin sticky sidebars) sits correctly at real viewport height.",
    "locator": "Single component/dialog. Removes page-level noise for reusable components.",
    "segmentedScroll": "Sequence of viewport captures at defined scroll offsets. Proves sticky behavior while scrolling."
  },
  "profiles": {
    "smoke": {
      "description": "Critical representative subset — one screen per surface plus the shell.",
      "grep": "@visual-smoke",
      "notes": "Scenarios opt in via the `profiles` field here AND the @visual-smoke tag on their spec title. Both must agree or the coverage audit reports the scenario as never captured."
    },
    "full": {
      "description": "Every non-excluded registered scenario. The default.",
      "grep": "@visual-regression"
    },
    "changed": {
      "description": "Intended for change-scoped selection on a PR.",
      "grep": "@visual-regression",
      "notes": "NOT YET IMPLEMENTED. Deliberately falls back to the full set rather than guessing a subset: a wrong change-impact heuristic silently skips the screen a PR actually broke. The wrapper logs the fallback so a `changed` run is never mistaken for a narrowed run."
    },
    "baseline": {
      "description": "Candidate generation over the same set as `full`.",
      "grep": "@visual-regression"
    },
    "diagnostic": {
      "description": "`full` with traces and video retained for every scenario, pass or fail.",
      "grep": "@visual-regression"
    }
  },
