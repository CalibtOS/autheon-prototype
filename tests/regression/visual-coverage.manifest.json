    {
      "id": "admin-large-desktop",
      "reason": "The admin console is only captured at 1440px. A large-desktop width changes table column visibility and sidebar proportions.",
      "viewport": "desktop-1920",
      "expands": {
        "surfaces": [
          "admin"
        ]
      },
      "owner": "frontend"
    },
    {
      "id": "interaction-states",
      "reason": "Focus-visible IS covered, but only for two components via the gallery pages (driver-header-focus-visible, marketplace-filter-focus-visible). Hover, expanded selects/dropdowns, open autocomplete results, disabled controls, and focus states on in-app screens rather than gallery pages are all unregistered.",
      "expands": {
        "states": [
          "hover",
          "select-expanded",
          "autocomplete-open",
          "control-disabled",
          "focus-visible on in-app screens"
        ]
      },
      "note": "The gallery-page pattern is the cheapest way to extend this: no Storybook or bundler is needed, and a gallery page can mount a component in every interaction state at once.",
      "owner": "frontend"
    },
    {
      "id": "empty-error-loading-states",
