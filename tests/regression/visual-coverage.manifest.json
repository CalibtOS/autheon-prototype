  "$plannedComment": [
    "Registered-but-not-yet-approved coverage. These entries are the honest record",
    "of what this framework does NOT yet prove. They are reported as MISSING",
    "COVERAGE by the coverage gate (non-blocking) until baselines are rendered by",
    "the Visual Regression Baseline workflow and approved. They become `active`",
    "in the same commit that adds their approved baseline."
  ],
  "planned": [
    {
      "id": "viewport-mode-sticky-chrome",
      "reason": "51 of the 53 registered captures are page-level fullPage: true; the other 2 are locator captures of a component gallery. NOTHING is captured in viewport mode. A full-page render stitches the document at its full height, so it cannot prove that the Driver PWA fixed bottom tabbar, the admin sticky job sidebars, or a sticky table header sit correctly at real viewport height.",
      "mode": "viewport",
      "expands": {
        "surfaces": [
          "driver",
          "admin"
        ],
        "screens": [
          "Marketplace",
          "My jobs",
          "Job execution detail",
          "Job overview",
          "Job detail",
          "New job form"
        ]
      },
      "owner": "frontend"
    },
    {
      "id": "segmented-scroll-sticky",
      "reason": "Sticky headers, sticky validation summaries, and the fixed bottom navigation change appearance while scrolling. A single capture at scroll offset 0 cannot detect a sticky element that detaches mid-scroll.",
      "mode": "segmentedScroll",
      "expands": {
        "surfaces": [
          "driver",
          "admin"
        ],
        "screens": [
          "Job overview",
          "New job form",
          "My jobs"
        ]
      },
      "owner": "frontend"
    },
    {
      "id": "locale-de-matrix",
      "reason": "German is the longest-translation locale and the wrapping risk case, but no snapshot is captured in DE. Localization-sensitive screens (tabbars, table headers, dialog action rows, settings toggles) need a DE matrix.",
      "locale": "de",
      "expands": {
        "profileFrom": "smoke-plus-overlays"
      },
      "owner": "frontend"
    },
    {
      "id": "theme-dark-matrix",
      "reason": "Dark is a production theme with its own tabbar box-shadow treatment, but every baseline is light-only.",
      "theme": "dark",
      "expands": {
        "profileFrom": "smoke-plus-overlays"
      },
      "owner": "frontend"
    },
    {
      "id": "pwa-standalone-route",
      "reason": "The /pwa/ route is a second real application surface (real-viewport Driver PWA, deep-linkable via ?tab=portal|mine|info|profile) with zero visual coverage. It has its own install mode bar and iOS install sheet that the iframe shell never renders.",
