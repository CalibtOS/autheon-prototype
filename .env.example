# AUTHEON test/CI environment template.
#
# Copy to .env for local runs. `.env` is gitignored and excluded from the Docker
# build context, so a local copy never reaches git or the image.
#
# Configuration model for this repository
# ---------------------------------------
# SMTP_PASSWORD is the ONLY value kept in GitHub Secrets. Everything else below
# is routing configuration for a dedicated CI mailbox, committed as real values
# so there is one place to read them and nothing silently defaults.
#
# Precedence, highest first:
#   1. environment variable (this file locally, workflow `env:` in CI)
#   2. committed defaults in scripts/lib/smtp-preflight.mjs
#
# So a fresh clone can run the notification path with only SMTP_PASSWORD set.
# See tests/docs/visual-regression-notifications.md.

# ---------------------------------------------------------------------------
# Visual regression email notification
# ---------------------------------------------------------------------------
SMTP_HOST=smtppro.zoho.eu
SMTP_USER=youssef.elkondakly@calibtos.com
# THE ONLY SECRET. Set it as GitHub repository secret SMTP_PASSWORD for CI, and
# here for local runs. Never pass it on a command line.
SMTP_PASSWORD=
# Envelope sender. "Name <address>" is accepted. Falls back to SMTP_USER.
SMTP_FROM=youssef.elkondakly@calibtos.com
# Recipient(s). Comma-separated for more than one.
REGRESSION_NOTIFICATION_EMAIL=calibtos.services@gmail.com

# ---------------------------------------------------------------------------
# Transport config
# ---------------------------------------------------------------------------
# 465 with SMTP_SECURE=true (implicit TLS, what Zoho Pro uses here), or
# 587 with SMTP_SECURE=false (STARTTLS). Any other combination is rejected by
# the notification preflight, because a mismatch surfaces later as an opaque
# connection timeout.
SMTP_PORT=465
SMTP_SECURE=true

# ---------------------------------------------------------------------------
# Visual regression behavior (all optional)
# ---------------------------------------------------------------------------
# true makes confirmed visual differences a BLOCKING failure. Default: false —
# only framework failures (missing baseline, missing capture, execution failure)
# block by default.
VISUAL_REGRESSION_STRICT=false
# full | smoke | changed | baseline | diagnostic. Default: full.
VISUAL_REGRESSION_PROFILE=full
# true retains a trace and video for EVERY scenario, pass or fail. Large.
VISUAL_REGRESSION_DIAGNOSTIC=false
# Write the email payload to the artifact without opening an SMTP connection.
REGRESSION_NOTIFICATION_DRY_RUN=
# Also send email on clean passing runs.
REGRESSION_NOTIFY_ON_SUCCESS=
# Make a notification delivery failure fail the pipeline. Off by default: a mail
# outage must not turn a non-blocking visual warning into a broken build.
REGRESSION_NOTIFICATION_REQUIRED=
# Attach the tar.gz archive when it is under the size limit below.
REGRESSION_ATTACH_ARCHIVE=
REGRESSION_ARCHIVE_ATTACHMENT_MAX_MB=10
REGRESSION_SUMMARY_ATTACHMENT_MAX_KB=512
# Free-text label shown in the report, e.g. "local", "ci", "staging".
REGRESSION_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Local Docker runner (optional)
# ---------------------------------------------------------------------------
# Host directory the container's artifact dir is mounted onto.
VISUAL_REGRESSION_DOCKER_ARTIFACT_DIR=
# Override when Docker Hub is unreachable and an internal mirror is used.
VISUAL_REGRESSION_DOCKER_BASE_IMAGE=
# Compare against a non-canonical local baseline set (e.g. darwin) to validate
# the FRAMEWORK without Docker. Only "linux" baselines are approved for merge
# decisions; a non-canonical run is labeled as such in every report.
VISUAL_REGRESSION_APPROVED_PLATFORM=

# ---------------------------------------------------------------------------
# E2E / app under test
# ---------------------------------------------------------------------------
# Port for the local static server. Both the server command and the URL
# Playwright waits on are derived from this.
E2E_PORT=4173
# Point the suite at an already-running deployment instead of starting a server.
E2E_BASE_URL=
APP_BASE_URL=
