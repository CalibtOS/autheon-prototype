// AUTHEON Version 1 database draft — PostgreSQL target.
// SOURCE OF TRUTH (binding): this file + logical-model.md (partial uniques, RLS, transition rules).
// Final audit 2026-08-10: 38 tables, 32 enums, 75 Refs; BE has 32 entity tables (0 BE-only);
// 6 DBML-only tables are intentional BE catch-up; binary meta only on upload_assets.
// See logical-model.md for constraints that DBML cannot express (partial unique indexes, RLS, and transition rules).
// 2026-08-10 — SCHEMA SYNC REVIEW (BE + prototype/PRD gap pass) + decided follow-ups:
//   - Added organizations (+ organization_status) — present in autheon-be TypeORM, previously absent here.
//   - Added drivers.second_phone (BE DriverEntity).
//   - Added notification_preferences.email_enabled (BE NotificationPreferenceEntity).
//   - Extended customers for Customer Center prototype: legal_form, structured address
//     (street/house_number/postal_code/city/country_code), joined_at, change_history jsonb
//     (UI trail; audit_events remains system of record — decision 3A).
//   - Annotated users.keycloak_id ↔ BE physical column identity_id (same meaning).
//   - Annotated BE synchronize lag: account_access / operational_access properties still map to
//     physical column name `status` until a wipe+reseed; target names in this file stay binding.
//   - Decision 1A: hybrid auth challenge state on users — password_reset_otp_*, password_reset_token_*,
//     account_setup_token_* (hashes + rate-limit counters only; passwords stay in Keycloak).
//     Amends the v2.24 "no reset state in AUTHEON" reading: still no session table and no
//     password_resets table; short-lived challenge hashes on users are allowed.
//   - Decision 2A: email_change_requests aligned to BE names (otp_hash, send_count,
//     window_started_at, last_sent_at, updated_at).
//   - Already present here but not yet in BE entities: consolidated_invoices(+jobs),
//     driver_documents, sp_cancellations, empty_run_reports/evidence — keep as target; BE catch-up.
//   - BE audit_events / job_assignments / user_notifications shapes remain BE-behind-DBML.
// 2026-08-10 — BE-BEHIND TARGET HARDENING (prototype/PRD as contract for unimplemented BE):
//   - empty_run_reason enum codes aligned to prototype machine ids (not_operational,
//     not_roadworthy, not_present, not_released, key_docs_missing, other) — was verbose
//     vehicle_* / key_or_documents_missing prefixes that matched neither UI nor seed data.
//   - File binaries (binding, no legacy copies): upload_assets is the ONLY home for
//     storage_key / original_name / filename / mime_type / extension / size / checksum.
//     Domain link rows carry upload_asset_id (+ business fields). Removed denormalized
//     copies from document_files, driver_documents, problem_report_evidence (aligned with
//     consolidated_invoices / empty_run_evidence / infopoint_documents). Clients still
//     get filename/MIME/size via join. generated_job_documents.file_name stays as the
//     client-required Fahrauftrag identity label; stored-binary checksum is
//     upload_assets.checksum via document_file_id (checksum_sha256 removed here).
//   - job_assignments documented as the BE catch-up contract (started_at/ended_at/assignment_type;
//     active row = ended_at IS NULL — replaces BE is_active / assigned_at / accepted_at / revoked_*).
//   - driver_documents / user_notifications / audit_events / sp_cancellations confirmed complete
//     vs PRD domain_model_summary; indexes annotated where DBML cannot express partial uniques.
// 2026-08-09 (PRD v2.36) — SERVICE-PARTNER (ONBOARDING) DOCUMENT UPLOAD, documented retroactively: the prototype's driverDocuments entity (store.js, Phase 7, surfaced in ServicePartnerProfileModal's "Documents" tab) had no backend counterpart in this file until now. This is the first PARTNER-scoped document model — every pre-existing document table (job_documents, document_files, generated_job_documents) is JOB-scoped and stays untouched. New driver_document_category enum (business_registration | licence_front | licence_back | id_front | id_back | other) and driver_document_status enum (uploaded | accepted | rejected | replaced) — deliberately SEPARATE from document_type and document_review_status: an onboarding document is never reviewed against a tour, never carries the missing/under_review/correction_required states, and its lifecycle adds 'replaced' for versioning. New driver_documents table (driver_id, category, upload_asset_id, valid_until, version, review_status, rejection_reason, supersedes_document_id/replaced_by_document_id, uploaded/reviewed audit columns). ONE ACTIVE DOCUMENT PER CATEGORY is a partial unique index on (driver_id, category) WHERE review_status IN ('uploaded','accepted') — a rejected or replaced row frees the slot so the partner can re-submit; see logical-model.md. Files reuse upload_assets (private access) exactly as infopoint_documents do; no second storage path. NO change to drivers (the link is driver_documents.driver_id), and NO change to job_documents. New audit_events.action_key values: driver_document_uploaded, driver_document_accepted, driver_document_rejected, driver_document_replaced, driver_document_removed, plus driver_document_viewed / driver_document_downloaded for the content-access trail (entity_type 'driver_document').
// 2026-07-31 (PRD v2.30) — CONSOLIDATED INVOICES (Admin Phase 12) schema added retroactively: the prototype's consolidatedInvoices entity had no backend counterpart in this file until now. New consolidated_invoice_status enum (in_review | correction_required | rejected | completed, deliberately separate from document_review_status and invoice_payment_status). New consolidated_invoices table (supplier_invoice_number, upload_asset_id, amount, driver_offer_sum snapshot, amount_mismatch, status, rejection_reason, internal_note, created_at/by) and consolidated_invoice_jobs join table — the first many-to-many relationship in this schema, since one consolidated invoice can span multiple completed jobs. Accepting an invoice only flips the linked jobs' existing job_financials.payment_status to 'paid'; it does not replace or duplicate that field. App-level guard (a job may not be linked to more than one non-rejected consolidated invoice at once) must be re-implemented server-side, e.g. a partial unique index or transactional check — see logical-model.md.
// 2026-07-29 (PRD v2.24) — AUTH DEMO (PR #32), documented retroactively. Keycloak remains the identity
// provider and AUTHEON stores no passwords / no session table / no password_resets table. AMENDED
// 2026-08-10 (decision 1A): AUTHEON MAY store short-lived hashed OTP / invite / post-OTP reset-token
// challenge state on users (see users.password_reset_* / account_setup_token_*), then call Keycloak
// to set the password. Prototype in-memory session scaffolding stays prototype-only. New
// audit_events.action_key values: driver_signed_in / admin_signed_in, driver_signed_out /
// admin_signed_out, driver_password_reset_requested / admin_password_reset_requested,
// driver_password_reset / admin_password_reset, driver_invite_accepted / admin_invite_accepted.
// 2026-07-29 (PRD v2.20) — TYPE-AWARE DRIVER NOTIFICATIONS. Added user_notifications.target_entity_type + target_entity_id (both nullable) so a notification carries a STABLE reference to the non-tour thing it opens — an infopoint_news row for an Infopoint message, a job_documents row for a document outcome. job_id already covered tour notifications; deep_link remains the client route DERIVED from these ids and is no longer treated as the navigation source of truth (an id survives renames and localization; a title or tour number does not). Also added the (user_id, created_at) and (target_entity_type, target_entity_id) indexes the notification list and the deep-link lookup need. No enum change: notification_type stays a free varchar and gains new_published_job for the in-app "newly published matching order" row (notification_channels_matrix driver_in_app false -> true for that event; the driver_push column and the push ELIGIBILITY rules are unchanged — the same enabled + newly-published-toggle + postal-area match gate decides who is notified). Notification CATEGORY (order | account | system | general_information) and the card's interaction model are DERIVED from notification_type in the application layer and deliberately NOT stored, so the taxonomy can change without a migration or stale rows.
// 2026-07-29 (PRD v2.25) — SCOPE REDUCTION on the content-access audit below: opening a driver NOTIFICATION is no longer audited (confirmed work-order revision). The notification_viewed action_key and the driver_notification entity_type are REMOVED; a notification points at content, and that content is already audited when the driver opens it, so the pointer entry duplicated the trail and arrived before the actual disclosure. user_notifications.read_at remains the notification-level record of what the driver has seen. Document and Infopoint-message auditing is unchanged. No structural change: audit_events simply stops receiving one action_key, and this trail never wrote to user_notifications.
// 2026-07-30 (PRD v2.26) — TRANSPORT-ORDER PDF GENERATION. generated_job_documents gains template_key, document_title, file_name, booked_at, source_data_revision, generation_trigger, service_partner_snapshot jsonb, gtc_document_id, gtc_version, checksum_sha256, source_checksum_sha256, changed_fields jsonb, generation_status and generation_error, plus a (job_id, document_kind, source_data_revision) unique index for generation idempotency and a partial unique index on is_current so exactly one active document per job is enforced by the database. Rows are immutable except is_current. NO change to drivers (street / house_number / postal_code / city / country_code already exist and are what the recipient snapshot is built from) and NO change to audit_events (action_key gains pdf_generation_failed; pdf_generated / pdf_regenerated / pdf_viewed / pdf_downloaded are unchanged keys). admins/users need the order creator's initials and telephone for the document's Auftragserstellung field — see logical-model.md.
//
// 2026-07-29 (PRD v2.19) — DRIVER CONTENT-ACCESS AUDIT. NO structural change: audit_events already carries everything the requirement needs (action_key, actor_user_id, entity_type, entity_id, job_id, occurred_at, metadata jsonb), so no column, table, enum, index or migration is added. New action_key values written when a driver reads driver-accessible content: document_viewed / document_downloaded (infopoint_documents), tour_document_viewed / tour_document_downloaded (job_documents), pdf_viewed / pdf_downloaded (generated_job_documents — pre-existing keys, now attributed to the acting DRIVER and not the dispatcher when the access comes from the Driver PWA), news_item_viewed (infopoint_news). entity_type carries infopoint_document | tour_document | transport_order_pdf | infopoint_news; entity_id the affected record; job_id the tour where the content belongs to one. metadata carries actionType ('viewed' | 'downloaded' — so the distinction survives any future key rename), the document version where the entity has one (infopoint_documents.version_label, generated PDF version; job_documents have no version field and none is added), and the document/notification subtype. Entries are APPEND-ONLY per interaction — repeated views and repeated downloads each insert a row; nothing is merged or updated. Reads that fail authorization or target a hidden/missing record currently write NOTHING (open question, see the v2.19 changelog).
// 2026-07-26 (PRD v2.8) — VEHICLE DOMAIN restructured per the client confirmation "Systemlogik Fahrzeugeingabe". Four explicit categories replace the fragmented vehicle inputs: new enums vehicle_type (passenger_car | truck_up_to_7_5_t | truck_over_7_5_t) and transport_type (own_axle | third_party_axle). jobs.axle_type -> jobs.transport_type; jobs.required_axle_type -> jobs.required_transport_type; notification_preferences.axle_type -> transport_type and its vehicle_type narrows to the enum. jobs.vehicle_type is the vehicle_type ENUM — only the three approved values are storable. jobs.vehicle_manufacturer becomes NOT NULL (manufacturer is now a dropdown selection, model a separate field). Added jobs.ready_to_drive boolean (Fahrbereit). REMOVED jobs.red_license_plates and jobs.red_license_plate_number entirely: the red-licence-plate REQUIREMENT is DERIVED at the domain layer as (vehicle_registration_status = 'deregistered' AND transport_type = 'own_axle') and is deliberately NOT stored, and the plate NUMBER is not recorded at all. The 2026-07-14 rule that forced licenseplate to NULL when deregistered is REVERSED: the official plate is required while registered and OPTIONAL-but-accepted once deregistered. VIN rule tightened to exactly 17 characters. vehicle_registration_status is NOT NULL. See logical-model.md "Vehicle domain".
// 2026-07-22 (PRD v2.5) — full admin order-editing implementation + Storno consistency pass. No new job columns: editing ALL eligible business data on any non-terminal order (Storno §7) reuses existing jobs/job_locations/job_financials columns and is audited via audit_events.action_key='order_edited' with metadata jsonb carrying the per-field {field, previous, new} diff list (one logical edit action; status is preserved, never mutated by an edit). Added empty_run_evidence (empty-run report attachments → upload_assets), mirroring problem_report_evidence, so §3.2 optional evidence has a first-class home instead of overloading the legacy job_problem_reports path. Legacy removal (PRD v2.6, 2026-07-23 — "ignore the special case"): the special_case job_status value and the problem_type.not_performable value have been REMOVED entirely (not merely deprecated) — the canonical driver problem workflow is sp_cancellations + empty_run_reports/empty_run_evidence, and the empty-run report model fully replaces the old not-performable → special-case path. New notification_type (user_notifications) values used by the app: order_updated_after_booking, empty_run_reported, empty_run_recognised, empty_run_not_recognised (notification_type stays a free varchar — no enum change).
// 2026-07-21 (PRD v2.4, T2) — order cancellation & empty-run workflow. Extended job_status with cancelled_by_sp, cancelled_by_autheon, empty_run_reported, empty_run_recognised, empty_run_not_recognised (decision: extended enum; board umbrellas + reason chip). Added cancellation_actor.service_partner; empty_run_reason / sp_cancellation_reason / empty_run_decision enums; sp_cancellations, empty_run_reports, internal_notes tables. New audit actions: cancelled_by_service_partner, cancelled_by_autheon, empty_run_reported, empty_run_recognised, empty_run_not_recognised, order_edited (prev+new), order_duplicated, internal_note_added, plus publication-of-duplicate.
// 2026-07-20 (PRD v2.3, T1) — driver self-service email change (verify, don't approve): added email_change_requests table (6-digit code sent to the NEW address, old address stays live until confirmed, no ops approval). Email is removed from the ops-managed master-data change scope — master_data_change_requests no longer carries email; users.email is changed only via a confirmed email_change_request. New audit actions driver_email_change_requested / driver_email_changed.
// 2026-07-14 (PRD v2.1 follow-up, same version) — [SUPERSEDED 2026-07-26 by PRD v2.8, see the v2.8 note above] important-vehicle-info conditional rules: added jobs.red_license_plate_number (§16 FZV dealer transfer plate, operator-bound); documented that licenseplate is app-required when registered and null when deregistered. Both of those rules are now GONE — the red-plate number column is removed, and a deregistered vehicle MAY carry a recorded official plate.
// 2026-07-13 (PRD v2.0, F-01) — removed deprecated master_data_change_type.daily_limit_override enum value. Documented that drivers.probation_job_limit is a per-driver snapshot seeded at creation from app_settings 'driver.acceptance.probationJobCount' (application-layer default, literal column default is a fallback only); no structural change to columns.
// Last updated: 2026-07-10 (PRD v2.0) — no structural change. Annotated drivers.driver_code semantics (F-03: system-assigned, immutable, never reused) and documented same-day per-leg time-window rule (F-04) in logical-model.md. Probation UI, Infopoint View/Download, branding/domain/Report-Problem-timing are UI/open items with no schema impact.
// 2026-07-09 (PRD v1.9, F-01) — replaced drivers.daily_job_limit with the one-time probation model (probation_job_limit + probation_cleared_at); removed master_data_change_type.daily_limit_override; renamed app_settings key driver.acceptance.defaultDailyJobLimit -> driver.acceptance.probationJobCount.
// 2026-07-03 — aligned upload-core asset model, document versioning, infopoint/problem upload links, and explicit job location windows with autheon-be TypeORM sync target.
//
// 2026-08-07 — STATUS CONSOLIDATION (binding: tasks/status-consolidation-decision-brief.md).
// Replaces the overloaded user_status / drivers.status vocabularies with two binary access
// axes plus an invite lifecycle. Pre-launch: wipe + synchronize + reseed (no migration).

Enum account_access {
  enabled
  disabled
}

Enum invite_state {
  pending
  failed
  accepted
}

Enum operational_access {
  enabled
  disabled
}

Enum organization_status {
  active
  inactive
  suspended
}

// SUPERSEDED 2026-08-07 — kept only so historical docs that mention the old
// single-axis vocabulary still compile. Do not use for new columns.
Enum user_status {
  pending_verification
  active
  suspended
  inactive
}

Enum user_role {
  user
  admin
  driver
}

// Task 2 (2026-07-21) extends the enum with explicit machine statuses for the
// Storno/empty-run workflow (decision: extended enum, not a discriminator —
// see prd.json client_status_mapping). Each has its own rules, ⚠-availability
// logic, and audit entries. The Jobs board groups them under umbrella columns
// (see logical-model.md "Status model") + a precise reason chip. `cancelled`
// is retained as a legacy umbrella for backward compat. The former
// `special_case` status has been REMOVED — the empty-run workflow
// (empty_run_reported/recognised/not_recognised) fully replaces it.
Enum job_status {
  draft
  published
  assigned
  accepted
  performed
  cancelled                  // legacy umbrella (pre-Task-2)
  cancelled_by_sp            // §2: service partner cancelled a booked order
  cancelled_by_autheon       // §5: admin/Autheon cancelled (booked or unbooked)
  empty_run_reported         // §3: empty run reported, pending Autheon review
  empty_run_recognised       // §4.1: review outcome — recognised (terminal)
  empty_run_not_recognised   // §4.2: review outcome — not recognised (terminal)
}

Enum assignment_mode {
  marketplace  // job published to marketplace; any eligible driver may accept
  direct       // job assigned directly to a specific driver
}

Enum assignment_type {
  direct_assignment
  marketplace_acceptance
  reassignment
}

Enum location_role {
  pickup
  delivery
}

// LEGACY (pre-Task-2). The canonical Storno driver flows are sp_cancellations
// (→ cancelled_by_sp) and empty_run_reports (→ empty_run_reported → review).
// The former `not_performable` value — which drove the removed special-case
// status — has been dropped; empty_run_reports fully replaces it.
Enum problem_type {
  cancel_order
}

Enum problem_status {
  submitted
  resolved
  withdrawn
}

Enum document_type {
  invoice
  fuel_receipt
  toll_receipt
  delivery_note
  waiting_time_evidence
  other_proof
  other_receipt
  transport_order
}

Enum document_review_status {
  missing
  uploaded
  under_review
  accepted
  rejected
  correction_required
}

// PRD v2.36 — SERVICE-PARTNER onboarding documents. Separate vocabularies from
// document_type / document_review_status above, which describe TOUR documents.
// Reusing those would force partner documents to carry states that cannot occur
// for them (missing / under_review / correction_required are tour-review states)
// and would block adding 'replaced', which tour documents express through the
// job_documents.current_file_id + document_files.supersedes_file_id pair instead.
Enum driver_document_category {
  business_registration  // Gewerbeanmeldung
  licence_front          // driving licence, front
  licence_back           // driving licence, reverse
  id_front               // identity document, front
  id_back                // identity document, reverse
  other                  // catch-all; the ONLY category that may legitimately repeat
}

Enum driver_document_status {
  uploaded   // submitted, awaiting admin review — occupies the category slot
  accepted   // admin accepted — occupies the category slot
  rejected   // admin rejected with a reason — FREES the slot for re-submission
  replaced   // superseded by a newer version; retained, never deleted
}

Enum settlement_status {
  not_started
  pending
  processed
  paid
  needs_clarification
  closed
}

Enum invoice_payment_status {
  invoice_missing
  invoice_received
  paid
  needs_clarification
}

// Added 2026-07-31 — Admin Phase 12 (Consolidated Invoices) client requirement.
// Deliberately separate from document_review_status / invoice_payment_status:
// a consolidated invoice is its own entity spanning multiple jobs, not a
// per-job document or per-job settlement state.
Enum consolidated_invoice_status {
  in_review
  correction_required
  rejected
  completed
}

Enum cancellation_actor {
  driver
  admin
  customer
  service_partner   // Task 2 §2: service partner self-cancelled a booked order
}

Enum empty_run_reason {
  // Machine codes match the Driver PWA / admin review maps (prototype driver.jsx /
  // admin.jsx). Labels are i18n-only — never store localized text.
  not_operational              // Fahrzeug ist technisch nicht fahrbereit
  not_roadworthy               // Fahrzeug ist nicht verkehrssicher
  not_present                  // am angegebenen Standort nicht vorhanden/auffindbar
  not_released                 // Fahrzeug wird nicht herausgegeben
  key_docs_missing             // Fahrzeugschlüssel oder Unterlagen fehlen
  other                        // Sonstiges
}

Enum sp_cancellation_reason {
  appointment_not_kept         // Termin kann nicht eingehalten werden
  booked_accidentally          // Auftrag versehentlich gebucht
  org_not_possible             // Durchführung organisatorisch nicht möglich
  other                        // Sonstiges
}

Enum empty_run_decision {
  recognised                   // §4.1 Anerkannt
  not_recognised               // §4.2 Nicht anerkannt
}

// ===========================================================================
// VEHICLE DOMAIN — client confirmation "Systemlogik Fahrzeugeingabe"
// (2026-07-26; see docs/archive/2026-07/prd-changelog-since-2026-07-27.md).
//
// Four EXPLICIT categories with distinct cardinalities. The earlier proposal to
// flatten all vehicle classifications into one unstructured multi-select tag
// collection was SUPERSEDED — no vehicle_tags / vehicle_classifications table
// exists or should be introduced.
// ===========================================================================

// Vehicle type — exactly one. These three values are the ONLY storable values.
Enum vehicle_type {
  passenger_car        // PKW
  truck_up_to_7_5_t    // LKW bis einschließlich 7,5 t
  truck_over_7_5_t     // LKW über 7,5 t
}

// Transport type — exactly one. Renames the former "axle type" concept.
Enum transport_type {
  own_axle             // Eigenachse
  third_party_axle     // Fremdachse
}

// Registration status — exactly one, INDEPENDENT of transport type. Never
// inferred from transport type.
Enum vehicle_registration_status {
  registered           // Zugelassen
  deregistered         // Abgemeldet
}

Enum master_data_change_type {
  bank_details
  address
  vehicle_info
  license
  contact  // company/phone/contact details only — email is NOT part of master data (T1); it is driver-owned and changed via email_change_requests.
}

// Driver self-service email change (T1, "verify, don't approve"). The driver
// owns their sign-in email (users.email). A change is proved by a 6-digit OTP
// sent to the NEW address; the OLD address stays active until the OTP is
// confirmed. No operations/admin approval is involved. Store a HASH of the
// OTP (`otp_hash`), never the plaintext. Enforce: at most one pending request
// per user (partial unique index on user_id where status = 'pending'); expiry,
// attempt cap, and send throttle (send_count / window_started_at / last_sent_at)
// live in the application/logical-model layer.
Enum email_change_status {
  pending
  confirmed
  expired
  cancelled
}

Table email_change_requests {
  id uuid [pk]
  user_id uuid [not null]  // FK users.id — the account whose sign-in email changes
  current_email varchar(255) [not null]  // snapshot of the old address at request time
  new_email varchar(255) [not null]
  // Aligned to BE EmailChangeRequestEntity (decision 2A, 2026-08-10).
  otp_hash varchar(255) [not null]  // hash of the 6-digit OTP; plaintext is only sent to new_email
  status email_change_status [not null, default: 'pending']
  attempts smallint [not null, default: 0]
  send_count smallint [not null, default: 1]  // includes the initial send; rate-limit window uses this
  window_started_at timestamptz [not null]    // start of the current send-rate-limit window
  last_sent_at timestamptz [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  confirmed_at timestamptz  // set on success; users.email + users.email_verified updated in the same transaction
  cancelled_at timestamptz
}

Enum notification_channel {
  in_app
  push
  email
}

Enum message_delivery_status {
  pending
  processing
  delivered
  failed
  cancelled
}

// PRD v2.34 / Task 33 (renumbered from v2.32 — main independently claimed
// v2.32 for an unrelated job-attachment-size-limits change) — admin-feed-only. Meaningful only on user_notifications
// rows delivered to an admin recipient; unused (default values) on
// driver-recipient rows, same table.
Enum notification_severity {
  red
  orange
  gray
}

// Values renamed 2026-08-05 (open -> unread, processed -> read) — naming
// change only, same admin-feed-only explicit-action-only rule as before.
Enum notification_status {
  unread
  read
}

// Tenant / Keycloak org mirror — autheon-be OrganizationEntity (platform bootstrap).
// No FK from users/jobs yet: org context is request middleware + Keycloak today.
Table organizations {
  id uuid [pk]
  alias varchar(100) [not null, unique]
  name varchar(255) [not null]
  status organization_status [not null, default: 'active']
  keycloak_org_id varchar(36) // nullable until realm org provisioning completes
  settings jsonb [not null, default: '{}']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table users {
  id uuid [pk]
  // Logical name. BE TypeORM column is currently `identity_id` (same meaning).
  keycloak_id varchar(36) [unique] // nullable until Keycloak provisioning completes; partial unique index where not null
  email varchar(255) [not null, unique]
  first_name varchar(100) [not null]
  last_name varchar(100) [not null]
  // Two-axis access model (status consolidation, 2026-08-07). Replaces user_status.
  // BE note: property `accountAccess` still maps to physical column name `status`
  // while synchronize:true is in use — target name here is binding after wipe+reseed.
  account_access account_access [not null, default: 'disabled']  // login / Keycloak enabled
  invite_state invite_state [not null, default: 'pending']       // onboarding lifecycle; orthogonal to account_access
  // Dormancy clock (brief E5). Moved here from drivers — activity is a fact about
  // the person, not the partner row. Sweep reads COALESCE(last_activity_at, created_at).
  last_activity_at timestamptz
  roles text [not null, default: 'user'] // TypeORM simple-array of user_role values
  email_verified boolean [not null, default: false]
  language varchar(8) [not null, default: 'de']
  // Hybrid auth challenge state (decision 1A, 2026-08-10). Passwords live in Keycloak only.
  // These columns hold short-lived HASHES + rate-limit counters so Autheon can email/verify
  // invite + password-reset OTPs, then call Keycloak to set the password. Never store plaintext.
  password_reset_otp_hash varchar(255)
  password_reset_otp_expires_at timestamptz
  password_reset_otp_attempts int [not null, default: 0]
  password_reset_otp_last_sent_at timestamptz
  password_reset_otp_send_count int [not null, default: 0]
  password_reset_otp_window_started_at timestamptz
  password_reset_token_hash varchar(255)  // issued after OTP verify; single-use; clears on confirm
  password_reset_token_expires_at timestamptz
  account_setup_token_hash varchar(255)   // invite / first-password setup link
  account_setup_token_expires_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz

  Indexes {
    last_activity_at [name: 'idx_users_last_activity_at']  // inactivity sweep range scan (joined from drivers)
  }
}

Table drivers {
  id uuid [pk]
  user_id uuid [not null, unique]
  driver_code varchar(64) [not null, unique]  // F-03: system-assigned from a monotonic sequence, immutable after creation, never reused (even after block/inactive/archive/soft-delete/departure); exact format client-defined (see prd.json production_open_questions)
  company_name varchar(255) [not null]
  contact_name varchar(255)
  street varchar(255)
  house_number varchar(32)
  postal_code varchar(32)
  city varchar(128)
  country_code char(2) [not null, default: 'DE']
  phone varchar(64)
  second_phone varchar(64) // optional alternate contact — present on BE DriverEntity
  notes text
  // One-time probation model (F-01, replaces former per-day daily_job_limit).
  probation_job_limit smallint [not null, default: 3]  // Per-driver SNAPSHOT of the probation allowance AND Performed-count release threshold. Seeded at driver creation from app_settings 'driver.acceptance.probationJobCount' by the application layer (see logical-model.md); the literal default here is only a safety fallback when the setting is unavailable. Snapshot semantics: later changes to the app_settings value do NOT retroactively affect existing drivers. Remaining allowance is derived (probation_job_limit minus count of Performed jobs from job_status_history), not stored.
  probation_cleared_at timestamptz  // set when driver is released from probation (auto after probation_job_limit Performed jobs, or manual admin release); null = still on probation
  // Marketplace eligibility (status consolidation). Replaces drivers.status
  // active|blocked|inactive. Binary: enabled | disabled.
  // BE note: property `operationalAccess` still maps to physical column name `status`
  // while synchronize:true is in use — target name here is binding after wipe+reseed.
  operational_access operational_access [not null, default: 'disabled']
  // Automatic access removal of inactive service partners (D6). Markers stay on
  // the driver row; the dormancy CLOCK lives on users.last_activity_at (E5).
  inactivity_warning_sent_at timestamptz  // Set when the pre-lockout warning is sent. Stale when marker < users.last_activity_at (brief R5) — not cleared by the stamp path.
  access_removal_deferred_at timestamptz  // Branch B: account lockout deferred because of open tours; operational access already removed. Once-per-dormancy notify.
  deactivation_reason varchar(32)  // 'inactivity' when the platform closed access via the sweep (both axes on Branch A; operational on Branch B); NULL when a human did. Provenance only — not a third axis.
  deleted_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table customers {
  id uuid [pk]
  name varchar(255) [not null]
  // Customer Center (prototype): legal form separate from free-text customer_type.
  legal_form varchar(100)
  customer_type varchar(100)
  billing_reference varchar(255)
  contact_name varchar(255)
  contact_email citext
  contact_phone varchar(64)
  // Structured customer address (prototype Customer Center) — distinct from
  // locations master data used as pickup/delivery address book.
  street varchar(255)
  house_number varchar(32)
  postal_code varchar(32)
  city varchar(128)
  country_code char(2) [default: 'DE']
  billing_notes text
  operational_instructions text
  notes text
  // Business-relationship start (prototype joinedAt). Set once on create.
  joined_at timestamptz
  // Decision 3A (2026-08-10): Customer Center UI trail — array of
  // { at, by, fields[] } matching the prototype. NOT the compliance export trail:
  // every customer field change MUST ALSO append audit_events (entity_type='customer').
  // audit_events is the system of record; change_history is the product UI convenience.
  change_history jsonb [not null, default: '[]']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
}

Table locations {
  id uuid [pk]
  name varchar(255) [not null]
  street varchar(255) [not null]
  house_number varchar(32)
  postal_code varchar(32) [not null]
  city varchar(128) [not null]
  country_code char(2) [not null, default: 'DE']
  contact_name varchar(255)
  alternate_contact_name varchar(255)
  phone varchar(64)
  second_phone varchar(64)
  email citext
  notes text
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  archived_at timestamptz
}

Table jobs {
  id uuid [pk]
  tour_number varchar(32) [not null, unique]
  category varchar(100) [not null]
  customer_id uuid [not null]
  customer_name_snapshot varchar(255) [not null]
  customer_type_snapshot varchar(100)
  customer_billing_reference_snapshot varchar(255)
  customer_billing_notes_snapshot text
  customer_instructions_snapshot text
  operational_status job_status [not null, default: 'draft']
  current_driver_id uuid
  distance_km numeric(10,2) // canonical tour distance: system estimate or admin-entered value (single field — no separate override or source column)
  // ---- Vehicle domain (client confirmation "Systemlogik Fahrzeugeingabe") ----
  // 1. Vehicle type — exactly one of the three approved values.
  vehicle_type vehicle_type [not null]
  // 2. Manufacturer — selected from the manufacturer catalogue (dropdown), and
  //    the model as its own separate free-text field.
  vehicle_manufacturer varchar(128) [not null]
  vehicle_model varchar(255) [not null]
  // 3. OFFICIAL licence plate of the TRANSPORTED vehicle. Never a red plate.
  //    Application rule: required while registration is 'registered' (or
  //    unspecified), OPTIONAL once 'deregistered' — a previous or de-stamped
  //    plate may still be recorded when known. Deregistration must NOT clear,
  //    hide or disable it.
  licenseplate varchar(32)
  // 4. VIN — confirmed rule: exactly 17 characters when present.
  vin varchar(17)
  // 5. Transport type — exactly one. Renames axle_type (see migration note).
  transport_type transport_type [not null]
  // 6. Registration status — exactly one, INDEPENDENT of transport_type.
  //    Never derived from transport_type.
  vehicle_registration_status vehicle_registration_status [not null]
  // 7. Additional vehicle characteristics — independent booleans.
  electric_vehicle boolean [not null, default: false]
  // 'Fahrbereit'. Decision-relevant for third-party-axle transport; applicability
  // drives UI emphasis only and the stored value is never auto-cleared.
  ready_to_drive boolean [not null, default: false]
  //
  // NO red-plate columns of any kind. The red-licence-plate REQUIREMENT is
  // DERIVED at the domain layer as (vehicle_registration_status = 'deregistered'
  // AND transport_type = 'own_axle') and is deliberately NOT stored: a stored
  // copy could drift from the two inputs and would be writable. See
  // logical-model.md → "Red licence plates". The plate NUMBER is not recorded at
  // all — partners bring their own plates and the number is irrelevant to
  // AUTHEON order creation.
  internal_notes text
  driver_visible_notes text
  // Determines publish flow and notification strategy
  assignment_mode assignment_mode [not null, default: 'marketplace']
  // Marketplace filter dimensions — matched against notification_preferences.postal_areas / vehicle_type / transport_type
  required_vehicle_type vehicle_type
  required_transport_type transport_type
  pickup_postal_area varchar(16)
  document_review_summary document_review_status [not null, default: 'missing']
  settlement_state settlement_status [not null, default: 'not_started']
  created_at timestamptz [not null]
  created_by_user_id uuid [not null]
  updated_at timestamptz [not null]
  // Denormalized for fast SLA/settlement queries — authoritative source is job_status_history
  accepted_at timestamptz
  performed_at timestamptz
  cancelled_at timestamptz
  cancelled_by_user_id uuid
  cancellation_actor cancellation_actor
  cancellation_reason_code varchar(100)
  cancellation_reason_text text  // driver-facing message when cancellation_actor is admin/dispatching; also used for driver cancel explanation
}

Table job_locations {
  id uuid [pk]
  job_id uuid [not null]
  location_type location_role [not null]
  sequence int [not null, default: 0]
  location_id uuid
  name varchar(255) [not null] // immutable snapshot
  street varchar(255) [not null] // immutable snapshot
  house_number varchar(32)
  postal_code varchar(32) [not null] // immutable snapshot
  city varchar(128) [not null] // immutable snapshot
  country_code char(2) [not null]
  contact_name varchar(255)
  alternate_contact_name varchar(255)
  phone varchar(64)
  second_phone varchar(64)
  email citext
  notes text
  scheduled_date date
  window_start time
  window_end time  // F-04: window is same-day only; window_end >= window_start (no cross-midnight). Pickup and delivery legs may still have different scheduled_date.
  window_is_flexible boolean [not null, default: false]
  completed_at timestamptz

  indexes {
    (job_id, location_type, sequence) [unique]
    (postal_code, scheduled_date)
  }
}

// Assignment history (BE catch-up contract). Prototype keeps assignee on the job
// object; production stores every direct assignment, marketplace acceptance, and
// reassignment here. Exactly one OPEN row per job:
//   partial unique index on (job_id) WHERE ended_at IS NULL
// (see logical-model.md — DBML cannot express partial uniques).
//
// BE today uses is_active / assigned_at / accepted_at / revoked_at / revoked_by_user_id.
// Target mapping for catch-up:
//   started_at  = when this assignment became current (assign or marketplace accept)
//   ended_at    = when superseded / revoked / completed away (NULL = active = BE is_active)
//   end_reason  = reassignment | revocation | job_terminal | …
//   assignment_type discriminates direct_assignment | marketplace_acceptance | reassignment
// Driver "accepted" timestamp for SLA stays on jobs.accepted_at (from job_status_history),
// not duplicated here.
Table job_assignments {
  id uuid [pk]
  job_id uuid [not null]
  driver_id uuid [not null]
  assignment_type assignment_type [not null]
  assigned_by_user_id uuid                 // null on marketplace_acceptance (system/driver self)
  started_at timestamptz [not null]
  ended_at timestamptz                     // NULL = currently active assignment
  end_reason varchar(100)
  notes text

  indexes {
    (job_id, started_at)
    (driver_id, started_at)
  }
}

Table job_status_history {
  id uuid [pk]
  job_id uuid [not null]
  previous_status job_status
  next_status job_status [not null]
  occurred_at timestamptz [not null]
  actor_user_id uuid
  evidence_document_file_id uuid
  comment text
  metadata jsonb

  indexes {
    (job_id, occurred_at)
  }
}

Table job_distance_estimates {
  id uuid [pk]
  job_id uuid [not null]
  provider varchar(100)
  routing_profile varchar(100)
  distance_km numeric(10,2) [not null]
  raw_response jsonb
  calculated_at timestamptz [not null]
  calculated_by_user_id uuid
  is_manual_override boolean [not null, default: false]
  override_reason text
}

Table job_financials {
  id uuid [note: 'BE surrogate PK; logical 1:1 with jobs']
  job_id uuid [unique, not null]
  // Operational V1 amounts (prototype + PRD)
  revenue_amount numeric(12,2) [note: 'Customer revenue / price']
  driver_offer_amount numeric(12,2) [note: 'Driver marketplace compensation']
  expenses_amount numeric(12,2)
  // Optional net/gross snapshot (BE + prototype)
  total_net numeric(12,2)
  total_gross numeric(12,2)
  // BE property `currency` maps to this column name in design docs
  currency_code char(3) [not null, default: 'EUR', note: 'BE column: currency']
  // BE property `vatRate` / column vat_rate
  tax_rate numeric(5,2) [note: 'BE column: vat_rate']
  invoice_received boolean [not null, default: false]
  admin_invoice_override boolean
  payment_status invoice_payment_status [not null, default: 'invoice_missing']
  notes text
  updated_at timestamptz [not null]
  updated_by_user_id uuid
  settlement_initiated_by uuid
  settlement_initiated_at timestamptz
}

// Added 2026-07-31 — Admin Phase 12 (Consolidated Invoices) client requirement.
// First entity in this schema where one record legitimately spans multiple
// jobs: a service partner can submit one invoice covering several completed
// tours, so this is a real many-to-many via consolidated_invoice_jobs, not a
// job_id FK on jobs itself. Kept entirely separate from job_financials /
// invoice_payment_status — accepting a consolidated invoice only flips the
// linked jobs' existing payment_status to 'paid', it does not replace that
// per-job settlement field.
Table consolidated_invoices {
  id uuid [pk]
  supplier_invoice_number varchar(100) [not null]
  // Binary + filename/MIME/size live on upload_assets — do not duplicate here.
  upload_asset_id uuid [not null]
  amount numeric(12,2) [not null]
  driver_offer_sum numeric(12,2) [not null, note: 'Snapshot of linked jobs driver_offer_amount at creation time, for the mismatch comparison']
  amount_mismatch boolean [not null, default: false]
  status consolidated_invoice_status [not null, default: 'in_review']
  rejection_reason text                    // also used for correction_required copy
  internal_note text
  created_at timestamptz [not null]
  created_by_user_id uuid [not null]
}

Table consolidated_invoice_jobs {
  id uuid [pk]
  consolidated_invoice_id uuid [not null]
  job_id uuid [not null, note: 'Must be status=performed at link time; a job may not be linked to more than one non-rejected consolidated invoice at once (app-level guard, mirrored server-side)']

  indexes {
    (consolidated_invoice_id, job_id) [unique]
  }
}

Table job_problem_reports {
  id uuid [pk]
  job_id uuid [not null]
  reported_by_user_id uuid
  reported_by_actor cancellation_actor [not null]
  reported_by_customer_id uuid
  problem_type problem_type [not null]
  reason_code varchar(100) [not null]
  reason_text text
  status_before_problem job_status [not null]
  report_status problem_status [not null, default: 'submitted']
  submitted_at timestamptz [not null]
  resolved_at timestamptz
  resolved_by_user_id uuid
  resolution_action varchar(100)
  resolution_note text
}

Table problem_report_evidence {
  id uuid [pk]
  problem_report_id uuid [not null]
  // Binary + filename/MIME/size live on upload_assets — do not duplicate here.
  upload_asset_id uuid [not null]
  created_at timestamptz [not null]
}

Table job_documents {
  id uuid [pk]
  job_id uuid [not null]
  document_type document_type [not null]
  source varchar(32) [not null] // driver_pwa | admin_off_channel | generated — drivers replace driver_pwa only
  uploaded_by_user_id uuid
  review_status document_review_status [not null, default: 'uploaded']
  processed_at timestamptz
  processed_by_user_id uuid
  rejection_reason text
  supplier_invoice_number varchar(100)
  supplier_invoice_date date
  notes text
  current_file_id uuid
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// Immutable file VERSION for a job_document. Binary metadata is NOT copied here —
// join upload_assets via upload_asset_id for original_name / mime_type / size /
// checksum / storage_key (BE catch-up: drop legacy denormalized columns).
Table document_files {
  id uuid [pk]
  job_document_id uuid
  upload_asset_id uuid [not null]
  scan_status varchar(32) [not null, default: 'pending'] // document-pipeline state, not binary meta
  scanned_at timestamptz
  uploaded_by_user_id uuid [not null]
  uploaded_at timestamptz [not null]
  supersedes_file_id uuid
  superseded_at timestamptz
}

Table job_document_reviews {
  id uuid [pk]
  job_document_id uuid [not null]
  review_status document_review_status [not null]
  reviewer_user_id uuid [not null]
  reason text
  occurred_at timestamptz [not null]
}

// 2026-08-09 (PRD v2.36) — SERVICE-PARTNER ONBOARDING DOCUMENTS. The first
// PARTNER-scoped document table: it hangs off drivers, NOT off jobs, and is what
// the admin Service Partner profile "Documents" tab reads. Deliberately a separate
// table rather than a nullable job_id on job_documents — the two have different
// lifecycles (onboarding/compliance vs per-tour settlement), different review
// vocabularies, different retention drivers, and only this one has an expiry date
// and a one-active-row-per-category rule. A nullable-FK merge would make every
// tour-document query filter on "job_id IS NOT NULL" forever.
//
// VERSIONING mirrors document_files.supersedes_file_id: a replacement INSERTS a new
// row (version + 1, review_status 'uploaded', supersedes_document_id -> the prior
// row) and marks the prior row 'replaced' with replaced_by_document_id pointing
// forward. The previous binary is never overwritten and the row is never deleted,
// so document history stays reviewable.
Table driver_documents {
  id uuid [pk]
  driver_id uuid [not null]
  category driver_document_category [not null]
  // Binary + filename/MIME/size on upload_assets (access 'private'). App enforces PDF+image
  // allowlist and the same per-file size ceiling as tour documents (app_settings, default
  // 25 MB / 50 MB platform cap) against upload_assets at write time — not duplicated here.
  upload_asset_id uuid [not null]
  valid_until date                        // optional expiry (client req. #8 "validity"); NULL = no expiry tracked. Expiry is DERIVED for display, never a stored status
  version smallint [not null, default: 1] // 1 for a first upload; incremented by each replacement
  review_status driver_document_status [not null, default: 'uploaded']
  rejection_reason text                   // required by the application when review_status = 'rejected'
  supersedes_document_id uuid             // -> driver_documents.id, the version this row replaced
  replaced_by_document_id uuid            // -> driver_documents.id, set on the OLD row when replaced
  uploaded_by_user_id uuid [not null]     // the partner's own user, or an admin uploading on their behalf
  uploaded_at timestamptz [not null]
  reviewed_by_user_id uuid                // admin who accepted/rejected
  reviewed_at timestamptz
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    (driver_id, category, uploaded_at)
    // Partial unique (logical-model.md): one active doc per (driver_id, category)
    // WHERE review_status IN ('uploaded','accepted') AND category <> 'other'
  }
}

// 2026-07-30 (PRD v2.26) — TRANSPORT-ORDER PDF. Extended so every generated
// document carries the full audit set the client technical specification
// requires. A row is IMMUTABLE after insert; the only column ever updated is
// is_current, and the partial unique index below makes "exactly one active
// document per job and kind" a database guarantee rather than application
// discipline. The previous binary is never overwritten: a relevant change
// inserts a new version_number pointing at a new document_files row.
Table generated_job_documents {
  id uuid [pk]
  job_id uuid [not null]
  document_file_id uuid [not null]
  document_kind varchar(64) [not null] // transport_order
  version_number int [not null]
  generated_at timestamptz [not null]
  generated_by_user_id uuid           // null when a system trigger generated it
  is_current boolean [not null, default: true]

  // --- v2.26 additions ---
  template_key varchar(16) [not null]      // pkw | lkw — resolved from jobs.vehicle_type, never from display text
  document_title varchar(64) [not null]    // FAHRAUFTRAG PKW | FAHRAUFTRAG LKW
  // Client-required Fahrauftrag download/audit identity (Fahrauftrag-<tour_number>.pdf).
  // On successful generation, write the same value to upload_assets.original_name via
  // document_files; do NOT add a second stored-binary checksum column here —
  // upload_assets.checksum is the binary hash.
  file_name varchar(255) [not null]
  booked_at timestamptz [not null]         // the binding-booking instant the document renders in Europe/Berlin
  source_data_revision int [not null]      // deterministic revision marker; generation is idempotent per (job_id, revision)
  generation_trigger varchar(32) [not null] // marketplace_acceptance | direct_assignment | relevant_change | admin_manual
  service_partner_snapshot jsonb [not null] // company, person, street, house number, postal code, city, country FROZEN at v1 and carried forward; later profile edits never alter any version
  gtc_document_id varchar(64) [not null]    // applicable AGB/GTC at booking time
  gtc_version varchar(32) [not null]
  source_checksum_sha256 char(64) [not null] // SHA-256 of the canonical render source (payload + markup) — the revision fingerprint (NOT the stored binary)
  changed_fields jsonb                      // relevant-change field keys, when generation_trigger = relevant_change
  generation_status varchar(32) [not null, default: 'generated'] // generated | failed
  generation_error text                     // missing mandatory fields or renderer error, when generation_status = failed

  indexes {
    (job_id, document_kind, version_number) [unique]
    // Idempotency: one document per job revision, so a retry or a duplicate
    // event cannot mint a second version.
    (job_id, document_kind, source_data_revision) [unique]
    // Exactly one active document per job and kind (partial index:
    // WHERE is_current — DBML has no partial-index syntax, see logical-model.md).
    (job_id, document_kind, is_current)
  }
}

Table master_data_change_requests {
  id uuid [pk]
  driver_id uuid [not null]
  requested_by_user_id uuid [not null]
  status varchar(32) [not null, default: 'open'] // open | approved | rejected
  change_type master_data_change_type [not null]  // discriminator for admin queue filtering and per-type validation
  requester_note text [not null]
  current_snapshot jsonb [not null]
  proposed_changes jsonb [not null]
  created_at timestamptz [not null]
  resolved_at timestamptz
  resolved_by_user_id uuid
  // Review audit — who reviewed and when
  reviewed_by_user_id uuid
  reviewed_at timestamptz
  admin_note text
}

// Task 2 §2 — service-partner cancellation of a booked order. Stored per §2.2:
// reason, explanation, date/time, executing partner. The job moves to
// cancelled_by_sp (jobs.operational_status) and stays in history; this row
// captures the cancellation detail. No cancellation-fee processing in-system.
Table sp_cancellations {
  id uuid [pk]
  job_id uuid [not null, unique]
  driver_id uuid [not null]              // executing service partner
  reason sp_cancellation_reason [not null]
  explanation text [not null]            // min 30 chars (app-enforced)
  created_at timestamptz [not null]
}

// Task 2 §3–§4 — empty-run report + admin review. One report per job (the ⚠
// action is blocked while pending). Optional evidence lives in empty_run_evidence
// (below) — never required to submit (§3.2). decision/decided_* set by admin review.
Table empty_run_reports {
  id uuid [pk]
  job_id uuid [not null, unique]
  driver_id uuid [not null]              // reporting service partner
  reason empty_run_reason [not null]     // prototype machine codes (see enum)
  description text [not null]            // min 30 chars (app-enforced)
  status_before varchar(32) [not null]   // assigned | accepted only (pre-report job status)
  reported_at timestamptz [not null]
  // Admin review (§4): exactly two outcomes, no intermediate state.
  decision empty_run_decision            // null while pending review
  decided_by_user_id uuid
  decided_at timestamptz
}

// Task 2 §3.2 — optional evidence attached to an empty-run report (photo or
// other proof). Mirrors problem_report_evidence but for the canonical empty-run
// workflow so evidence is not overloaded onto the legacy job_problem_reports path.
// Evidence is OPTIONAL and must never block submission of the report.
Table empty_run_evidence {
  id uuid [pk]
  empty_run_report_id uuid [not null]
  // Binary + filename/MIME/size live on upload_assets — do not duplicate here.
  upload_asset_id uuid [not null]
  created_at timestamptz [not null]
}

// Task 2 §6 — internal admin notes. Admin-only; NEVER exposed in the
// service-partner frontend. Optional; auto-stamped with author + timestamp;
// permanently attached to the order (append-only, not editable/deletable).
Table internal_notes {
  id uuid [pk]
  job_id uuid [not null]
  author_user_id uuid [not null]        // acting admin (name auto-stored)
  body text [not null]
  created_at timestamptz [not null]
}

Table infopoint_documents {
  id uuid [pk]
  title varchar(255) [not null]
  description text
  category varchar(100)
  scope varchar(100) [not null, default: 'global']
  version_label varchar(64)
  upload_asset_id uuid [not null]
  is_visible boolean [not null, default: true]
  published_at timestamptz [not null]
  updated_at timestamptz [not null]
  updated_by_user_id uuid
}

Table upload_assets {
  id uuid [pk]
  storage_key varchar(512) [not null, unique]
  original_name varchar(255) [not null]
  filename varchar(255) [not null]
  mime_type varchar(128) [not null]
  extension varchar(16) [not null]
  size int [not null]
  checksum varchar(64) [not null]
  access varchar(32) [not null] // public | private
  purpose varchar(64) [not null] // generic @autheon/shared UploadPurpose value, e.g. private-document-or-image
  owner_id uuid [not null]
  status varchar(32) [not null, default: 'active']
  url varchar(1024)
  relative_path varchar(1024)
  variants jsonb [not null, default: '[]']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table infopoint_news {
  id uuid [pk]
  subject varchar(255) [not null]
  body text [not null]
  published_at timestamptz [not null]
  is_visible boolean [not null, default: true]
  notify_in_app boolean [not null, default: true]
  notify_push boolean [not null, default: false]
  created_by_user_id uuid [not null]
  updated_at timestamptz [not null]
}

Table infopoint_news_reads {
  news_id uuid [not null]
  user_id uuid [not null]
  read_at timestamptz [not null]

  indexes {
    (news_id, user_id) [pk]
  }
}

Table notification_preferences {
  user_id uuid [pk]
  push_enabled boolean [not null, default: false]
  email_enabled boolean [not null, default: false] // BE NotificationPreferenceEntity; channel master toggle
  notify_published_jobs boolean [not null, default: false]
  notify_postal_area boolean [not null, default: false]
  // Array of postal area codes — replaces single pickup_postal_prefix to support multi-area subscriptions
  postal_areas text[] [not null, default: '{}']
  // Filter preference: an approved vehicle_type value or NULL (= no filter).
  vehicle_type vehicle_type
  transport_type transport_type
  updated_at timestamptz [not null]
}

Table push_subscriptions {
  id uuid [pk]
  user_id uuid [not null]
  endpoint text [not null, unique]
  p256dh_key text [not null]
  auth_key text [not null]
  user_agent text
  created_at timestamptz [not null]
  last_seen_at timestamptz
  revoked_at timestamptz
  // Set to false on HTTP 410 Gone from push service — prevents retrying expired subscriptions
  is_active boolean [not null, default: true]
}

// Shared in-app notification store for drivers AND admins (BE catch-up contract).
// BE today is a thinner shape (event_type / data jsonb / is_read). Target columns
// below are binding for catch-up — do not regress this table to the thin BE shape.
// Driver rows: notification_type + job_id/target_* + read_at; severity/status/
// admin_read_*/deleted_at stay at defaults and are unused.
// Admin feed rows (Task 33): severity, status, admin_read_*, deleted_at are live;
// prototype adminEmailQueue is the client stand-in (flatter jobId/documentId/
// driverId fields — production uses target_entity_type/id instead).
Table user_notifications {
  id uuid [pk]
  user_id uuid [not null]
  notification_type varchar(100) [not null]
  job_id uuid
  // PRD v2.20 — STABLE deep-link target. `job_id` already covers tour
  // notifications; these two cover the non-tour targets an Infopoint or a
  // document notification must open exactly (infopoint_news / job_documents).
  // Navigation resolves through these ids, never through title/body/tour text.
  // `deep_link` stays the client route derived FROM them, not the source of truth.
  // Admin feed also uses target_entity_type='driver' for service_partner_inactive.
  target_entity_type varchar(64)
  target_entity_id uuid
  title varchar(255) [not null]
  body text
  deep_link varchar(1024)
  created_at timestamptz [not null]
  read_at timestamptz                      // driver-notification read receipt (set on VIEWING)
  // PRD v2.34 / Task 33 (renumbered from v2.32 — main independently claimed
// v2.32 for an unrelated job-attachment-size-limits change) — admin-feed-only (see notification_severity /
  // notification_status above). Never meaningful on a driver-recipient row.
  // Deliberately NOT named read_at/read_by_user_id: this table's existing
  // read_at above is the driver-notification read receipt, set on VIEWING;
  // the admin equivalent flips ONLY via an explicit "mark as read" action,
  // never on view, so it needs its own name to keep the two rules from
  // silently merging. Status enum values renamed 2026-08-05 (open -> unread,
  // processed -> read); columns renamed the same day (processed_at/
  // processed_by_user_id -> admin_read_at/admin_read_by_user_id).
  severity notification_severity [not null, default: 'gray']
  status notification_status [not null, default: 'unread']
  admin_read_at timestamptz
  admin_read_by_user_id uuid
  // 2026-08-05: soft delete for the admin feed's "Delete" action (per-row,
  // "delete selected", "delete all") — a deleted row is hidden from every
  // admin-facing read but never erased, so it stays available for audit.
  deleted_at timestamptz

  indexes {
    (user_id, created_at)
    (target_entity_type, target_entity_id)
  }
}

Table outbox_events {
  id uuid [pk]
  event_type varchar(100) [not null]
  aggregate_type varchar(100) [not null]
  aggregate_id uuid [not null]
  payload jsonb [not null]
  occurred_at timestamptz [not null]
  available_at timestamptz [not null]
  status message_delivery_status [not null, default: 'pending']
  deduplication_key varchar(255) [unique]
}

Table notification_deliveries {
  id uuid [pk]
  user_notification_id uuid [not null]
  channel notification_channel [not null]
  status message_delivery_status [not null, default: 'pending']
  attempt_count int [not null, default: 0]
  last_attempt_at timestamptz
  delivered_at timestamptz
  error_message text
}

Table feature_flags {
  key varchar(100) [pk]
  is_enabled boolean [not null, default: false]
  description text
  updated_at timestamptz [not null]
  updated_by_user_id uuid
}

Table app_settings {
  key varchar(100) [pk]  // canonical keys: branding.display, operational.policies, cancellation.policies, driver.acceptance.probationJobCount (F-01: source of the seed value copied into drivers.probation_job_limit at driver creation; replaces driver.acceptance.defaultDailyJobLimit)
  value jsonb [not null]
  updated_at timestamptz [not null]
  updated_by_user_id uuid
}

// Append-only audit (BE catch-up contract). BE today uses a forensics-oriented
// shape (action / actor_id / target_type / target_id / changes / request_id /
// trace_id / ip). Target columns below are binding for product audit + content-
// access trails (PRD v2.19 / v2.36): action_key, actor_user_id, entity_type,
// entity_id, job_id, occurred_at, metadata jsonb. Extra BE forensics fields may
// be added later as optional columns; they must not replace action_key/entity_*.
Table audit_events {
  id uuid [pk]
  occurred_at timestamptz [not null]
  actor_user_id uuid                       // null for System
  action_key varchar(100) [not null]       // stable English key, never localized
  entity_type varchar(100) [not null]
  entity_id uuid
  job_id uuid
  metadata jsonb

  indexes {
    (job_id, occurred_at)
    (entity_type, entity_id, occurred_at)
    (action_key, occurred_at)
  }
}

